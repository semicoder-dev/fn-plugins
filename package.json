{
  "name": "fn-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && bun scripts/check.ts && bun fmt --no-script --check plugins examples scripts package.json tsconfig.json",
    "test": "bun test plugins",
    "build": "bun scripts/build.ts",
    "pack": "bun scripts/build.ts --pack",
    "market:local": "bun scripts/local-market.ts",
    "fmt": "bun fmt --no-script plugins examples scripts package.json tsconfig.json",
    "verify:independent": "bun scripts/verify-independent.ts",
    "release:check": "bun scripts/check-release-dependencies.ts"
  },
  "devDependencies": {
    "@semicoder/fn-sdk": "0.7.0",
    "@semicoder/fn-ui": "0.2.0",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
