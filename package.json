{
  "name": "fn-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "check": "bun node_modules/typescript/bin/tsc --noEmit && bun scripts/tasks.ts check",
    "build": "bun scripts/tasks.ts build",
    "pack": "bun scripts/tasks.ts pack",
    "test": "bun test ./tests ./plugins/web-search/tests",
    "index:check": "bun scripts/catalog.ts check"
  },
  "devDependencies": {
    "@semicoder/fn-sdk": "0.3.4",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "7.1.3"
  }
}
