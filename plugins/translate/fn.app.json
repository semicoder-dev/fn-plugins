{
  "manifestVersion": 1,
  "id": "fn-translate",
  "version": "0.3.1",
  "hostApi": 2,
  "name": {
    "key": "app.name"
  },
  "description": {
    "key": "app.description"
  },
  "entries": {
    "backend": "src/backend.ts",
    "page": "src/page.tsx"
  },
  "locales": {
    "default": "zh-CN",
    "messages": {
      "zh-CN": "locales/zh-CN.json",
      "en": "locales/en.json"
    }
  },
  "uses": ["application.summary", "models.responses", "chat.receive"],
  "contributes": {
    "chat": {
      "id": "translate",
      "name": {
        "key": "app.name"
      }
    },
    "summary": {
      "initial": "summary/initial.json"
    }
  }
}
